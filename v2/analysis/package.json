{
  "name": "@superdoc/v2-analysis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Raw OOXML surface analysis and corpus auditing for SuperDoc v2.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "scan": "tsx src/cli/raw-surface.ts",
    "universe": "tsx src/cli/universe.ts",
    "support-matrix": "tsx src/cli/support-matrix.ts",
    "v1-bridge": "tsx src/cli/v1-bridge.ts"
  },
  "dependencies": {
    "fflate": "catalog:",
    "saxes": "catalog:"
  },
  "devDependencies": {
    "fast-glob": "catalog:"
  }
}
