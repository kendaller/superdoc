{
  "name": "@superdoc/v2-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Package-backed DOCX model foundation for SuperDoc v2.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "catalog:",
    "saxes": "catalog:",
    "@superdoc/style-engine": "workspace:*",
    "@superdoc/contracts": "workspace:*"
  }
}
